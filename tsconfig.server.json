{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "dist/server",
    "sourceMap": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/server/**/*.ts", "src/contracts/**/*.ts"]
}
