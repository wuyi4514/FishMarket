{
  "name": "fishmarket-ai-builder-cup-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "ROOM_STORE=memory GEMINI_MODE=fixture PORT=8080 tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "verify": "pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@google-cloud/firestore": "9.3.1",
    "@google/genai": "2.28.0",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
